# Marketing Analytics: PRODUCTION template.
# Copy to .env (single install) or let `npm run provision-client` create one per customer, then fill in every
# value marked REQUIRED. The app refuses to start in production if a REQUIRED secret is missing or weak
# (see src/lib/config.ts). Never commit the filled-in file; back it up, because a lost SECRETS_ENCRYPTION_KEY
# cannot be recovered.
#
# Generate each secret on your server with:  openssl rand -base64 48
#
# Start:  docker compose up -d --build   then check   curl https://YOUR-DOMAIN/api/health

# ── 1. REQUIRED: product, URL and proxy ──────────────────────────────────
# Product name: NEXT_PUBLIC_DASHBOARD_NAME is read at BUILD time only (it is baked into the client bundle), and the
# Docker image does not pass it through, so setting it here has no effect with `docker compose up --build`.
# Customers on the Exclusive plan can set their own product name in the app (Plan & Billing).
APP_BASE_URL=https://dash.your-domain.com   # REQUIRED: the public https:// URL (emails, OAuth and payment redirects)
TRUST_PROXY=true                            # true because a reverse proxy (Caddy/nginx/Traefik) sits in front
TRUST_PROXY_HOPS=1                          # number of proxies in front of the app

# ── 2. REQUIRED: database ────────────────────────────────────────────────
# docker-compose builds DATABASE_URL for the app container from this password; use a long random value.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM
# Only needed when you run WITHOUT docker-compose (managed PostgreSQL, plain server):
# DATABASE_URL="postgresql://dashboard:PASSWORD@HOST:5432/dashboard?sslmode=require"
# DATABASE_POOL_MAX=10

# ── 3. REQUIRED: secrets (each different, 32+ characters; CRON_SECRET 24+) ─
AUTH_SECRET=REPLACE_WITH_RANDOM             # signs session cookies
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM  # encrypts stored API tokens. BACK THIS UP.
CRON_SECRET=REPLACE_WITH_RANDOM             # protects the scheduled fetch/report endpoints
SETUP_TOKEN=REPLACE_WITH_RANDOM             # lets the owner create the first account at /signup (or use `npm run create-owner`)

# ── 4. REQUIRED for a real launch: legal entity (shown on /terms, /privacy, /refund-policy) ──
COMPANY_NAME="Your Company (Pvt) Ltd"       # have a lawyer review the legal text before launch
COMPANY_ADDRESS="Street, City"
COMPANY_COUNTRY=Pakistan                    # also the governing law in the Terms
SUPPORT_EMAIL=support@your-domain.com
LEGAL_EFFECTIVE_DATE=2026-10-22
REFUND_WINDOW_DAYS=7                        # 0 = no refunds

# ── 5. Email (Resend): invitations, password resets, scheduled report digests ──
# Verify your sending domain in Resend first, or messages will not be delivered.
RESEND_API_KEY=
INVITE_FROM_EMAIL="Marketing Analytics <no-reply@your-domain.com>"   # must be on the verified domain

# ── 6. Connect buttons (OAuth apps). Redirect URIs to register at each provider: ──
#    {APP_BASE_URL}/api/oauth/google/callback   /api/oauth/meta/callback   /api/oauth/linkedin/callback
# Meta and LinkedIn need app review before real customers can connect: apply early.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── 7. Payments ──────────────────────────────────────────────────────────
# Safepay (Pakistan, PKR). Register the webhook: {APP_BASE_URL}/api/billing/safepay/webhook
# Test everything in sandbox first, then switch the line below to production.
SAFEPAY_ENVIRONMENT=production              # sandbox | production (production takes real money)
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_AMOUNT_UNIT=major                 # use "minor" only if the sandbox showed amounts 100x too large

# Lemon Squeezy (international, USD, merchant of record). Register the webhook:
#   {APP_BASE_URL}/api/billing/lemonsqueezy/webhook
# Events: subscription_created, subscription_updated, subscription_cancelled, subscription_expired,
#         subscription_resumed, subscription_paused, subscription_unpaused, subscription_payment_success,
#         subscription_payment_failed, subscription_payment_recovered
# Variant prices must equal src/lib/billing/plans.ts: $7/$19/$35 monthly, $70/$190/$350 yearly.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_TEST_MODE=true               # remove (or leave unset) in production
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_EXCLUSIVE_MONTHLY=
LEMONSQUEEZY_VARIANT_EXCLUSIVE_YEARLY=

# Offline / invoiced customer instead of online payments: FREE | STARTER | PRO | EXCLUSIVE
LICENSE_PLAN=

# ── 8. Visitor country (decides PKR/Safepay vs USD/Lemon Squeezy; users are never asked) ──
# Behind Cloudflare/Vercel/CloudFront the country header is used automatically (needs TRUST_PROXY=true).
DEFAULT_BILLING_REGION=PK                   # PK | INTL: used when the country cannot be determined
# GEOIP_URL=https://ipwho.is/{ip}
# GEOIP_API_KEY=
# GEOIP_FORCE_COUNTRY=                      # NEVER set in production (the app refuses to start)

# ── 9. Fetching, logging, backups ────────────────────────────────────────
SYNC_LOOKBACK_DAYS=35
LOG_LEVEL=info                              # debug | info | warn | error
# docker-compose mounts the HOST folder BACKUP_DIR (default ./backups next to docker-compose.yml) at /backups in the
# container, and this same variable is also passed into the container. So do not set a relative path here; run the
# backup inside the container pointing at the mount, so the files land on the host and survive rebuilds:
#   docker compose exec -e BACKUP_DIR=/backups dashboard npm run backup      (schedule daily, then TEST a restore)
# Set BACKUP_DIR below only to move the HOST folder to an absolute path such as /var/backups/dashboard.
# BACKUP_DIR=/var/backups/dashboard
BACKUP_ENCRYPTION_KEY=                      # set to encrypt backups at rest
BACKUP_KEEP=14

# ── Optional global channel credentials (a per-channel token always wins) ──
# LINKEDIN_ACCESS_TOKEN=
# META_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

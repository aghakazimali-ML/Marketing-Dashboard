# Marketing Analytics Dashboard

# Optional product name shown in the app and report headers
NEXT_PUBLIC_DASHBOARD_NAME="Marketing Analytics"

# In production, use an absolute path outside the app folder for persistence (e.g., "file:/var/data/dashboard.db")
DATABASE_URL="file:./prisma/dev.db"

# true = always demo data; false = live APIs when tokens below are set
SYNC_MOCK=false

# LinkedIn Marketing / Community Management API
LINKEDIN_ACCESS_TOKEN=
# Channel.externalId = organization id or urn:li:organization:{id}

# Meta Graph API (Facebook Pages + Instagram Business)
META_ACCESS_TOKEN=
# Channel.externalId = page id / IG business account id

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
# Channel.externalId = YouTube channel id

# Google Analytics 4 Data API
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

# Must be a long, random string in production (e.g. generate with openssl rand -base64 32)
AUTH_SECRET=your_random_secret_string_here

# The first owner account is created once at /signup after the database is set up.

# Invitation email delivery through Resend. Use a sender address verified in Resend.
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
INVITE_FROM_EMAIL="Marketing Analytics <invites@example.com>"

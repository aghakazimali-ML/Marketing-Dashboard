# Marketing Analytics: configuration reference. Copy to .env and fill in.
# All variables are validated at startup (src/lib/config.ts); production refuses to start with weak/missing secrets.

# ── Product ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_NAME="Marketing Analytics"   # default product name (Exclusive plan can override in-app)

# ── Database (PostgreSQL 14+) ─────────────────────────────────────────────
# Local development:  docker run -d --name dash-pg -e POSTGRES_USER=dash -e POSTGRES_PASSWORD=dash -e POSTGRES_DB=dashboard -p 5432:5432 postgres:16
DATABASE_URL="postgresql://dash:dash@localhost:5432/dashboard"
# Only used by docker-compose (the app container gets its DATABASE_URL from this password):
POSTGRES_PASSWORD=
# DATABASE_POOL_MAX=10

# ── Secrets (generate each with: openssl rand -base64 48) ─────────────────
AUTH_SECRET=                    # signs session cookies. 32+ chars in production.
SECRETS_ENCRYPTION_KEY=         # encrypts stored API tokens (AES-256-GCM). 32+ chars in production. Back it up!
# SECRETS_ENCRYPTION_KEY_PREVIOUS=   # during key rotation: the old key(s), comma separated. Then run `npm run rotate-secrets`.
SETUP_TOKEN=                    # required to create the first owner at /signup (or use `npm run create-owner`).
CRON_SECRET=                    # protects POST /api/cron/sync and /api/cron/reports. 24+ chars.

# ── Networking ────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000   # public URL (https:// in production). Used in emails, OAuth redirects, Stripe.
TRUST_PROXY=false               # true only when behind a reverse proxy that sets X-Forwarded-For (needed for per-IP rate limits)
TRUST_PROXY_HOPS=1              # number of trusted proxies in front of the app

# ── Email (Resend): invitations, password reset, reconnect alerts, report digests ──
RESEND_API_KEY=
INVITE_FROM_EMAIL="Marketing Analytics <no-reply@example.com>"   # must be a verified sender

# ── Fetching ──────────────────────────────────────────────────────────────
SYNC_LOOKBACK_DAYS=35           # days re-fetched on each run (first fetch of a channel backfills ~90)
LOG_LEVEL=info                  # debug | info | warn | error

# ── Optional global credentials (a per-channel token always wins) ─────────
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS= # path to (or inline JSON of) a Google service-account key for GA4

# ── OAuth apps: enable the one-click "Connect" buttons (see README: Connecting your channels) ──
# Redirect URIs to register:  {APP_BASE_URL}/api/oauth/google/callback  /meta/callback  /linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Plans & billing ───────────────────────────────────────────────────────
# Fix this installation's plan without Stripe (offline licence / managed hosting): FREE | STARTER | PRO | EXCLUSIVE
LICENSE_PLAN=
# Stripe (online subscriptions). Webhook endpoint: {APP_BASE_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_EXCLUSIVE_MONTHLY=
STRIPE_PRICE_EXCLUSIVE_YEARLY=

# ── Backups ───────────────────────────────────────────────────────────────
# BACKUP_DIR=./backups          # needs pg_dump (postgresql-client)
# BACKUP_ENCRYPTION_KEY=        # set to encrypt backups at rest
# BACKUP_KEEP=14                # keep the newest N backups

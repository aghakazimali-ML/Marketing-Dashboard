# Marketing Analytics: configuration reference. Copy to .env and fill in.
# All variables are validated at startup (src/lib/config.ts); production refuses to start with weak/missing secrets.

# ── Product ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_NAME="Marketing Analytics"   # default product name (Exclusive plan can override in-app)

# ── Database (PostgreSQL 14+) ─────────────────────────────────────────────
# Local development:  docker run -d --name dash-pg -e POSTGRES_USER=dash -e POSTGRES_PASSWORD=dash -e POSTGRES_DB=dashboard -p 5432:5432 postgres:16
DATABASE_URL="postgresql://dash:dash@localhost:5432/dashboard"
# Only used by docker-compose (the app container gets its DATABASE_URL from this password):
POSTGRES_PASSWORD=
# DATABASE_POOL_MAX=10

# ── Secrets (generate each with: openssl rand -base64 48) ─────────────────
AUTH_SECRET=                    # signs session cookies. 32+ chars in production.
SECRETS_ENCRYPTION_KEY=         # encrypts stored API tokens (AES-256-GCM). 32+ chars in production. Back it up!
# SECRETS_ENCRYPTION_KEY_PREVIOUS=   # during key rotation: the old key(s), comma separated. Then run `npm run rotate-secrets`.
SETUP_TOKEN=                    # required to create the first owner at /signup (or use `npm run create-owner`).
CRON_SECRET=                    # protects POST /api/cron/sync and /api/cron/reports. 24+ chars.

# ── Networking ────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000   # public URL (https:// in production). Used in emails, OAuth redirects, payment redirects.
TRUST_PROXY=false               # true only when behind a reverse proxy that sets X-Forwarded-For (needed for per-IP rate limits)
TRUST_PROXY_HOPS=1              # number of trusted proxies in front of the app

# ── Email (Resend): invitations, password reset, reconnect alerts, report digests ──
RESEND_API_KEY=
INVITE_FROM_EMAIL="Marketing Analytics <no-reply@example.com>"   # must be a verified sender

# ── Fetching ──────────────────────────────────────────────────────────────
SYNC_LOOKBACK_DAYS=35           # days re-fetched on each run (first fetch of a channel backfills ~90)
LOG_LEVEL=info                  # debug | info | warn | error

# ── Optional global credentials (a per-channel token always wins) ─────────
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS= # path to (or inline JSON of) a Google service-account key for GA4

# ── OAuth apps: enable the one-click "Connect" buttons (see README: Connecting your channels) ──
# Redirect URIs to register:  {APP_BASE_URL}/api/oauth/google/callback  /meta/callback  /linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Plans & billing (prices are in Pakistani rupees, see src/lib/billing/plans.ts) ──
# Safepay (Pakistan, primary): customers pay once per month/year; the plan runs until the paid period ends.
# Dashboard.getsafepay.com -> Developers: API key, "v1" secret key, webhook shared secret.
# Webhook URL to register: {APP_BASE_URL}/api/billing/safepay/webhook
SAFEPAY_ENVIRONMENT=sandbox        # sandbox | production (must be production to take real payments)
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_AMOUNT_UNIT=major        # major = whole rupees (default). Use "minor" only if the sandbox shows 100x amounts.
# Fix this installation's plan without online payments (offline licence / managed hosting): FREE | STARTER | PRO | EXCLUSIVE
LICENSE_PLAN=
# Lemon Squeezy (international customers, USD, merchant of record: handles VAT/sales tax).
# Create a store, then one subscription product with monthly + yearly variants per plan (prices must equal the
# USD figures in src/lib/billing/plans.ts). Webhook URL: {APP_BASE_URL}/api/billing/lemonsqueezy/webhook
# Events: subscription_created, subscription_updated, subscription_cancelled, subscription_expired,
#         subscription_resumed, subscription_paused, subscription_unpaused, subscription_payment_success,
#         subscription_payment_failed, subscription_payment_recovered
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=       # the "signing secret" you set on the webhook
# LEMONSQUEEZY_TEST_MODE=true      # use while testing with a test-mode API key
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_EXCLUSIVE_MONTHLY=
LEMONSQUEEZY_VARIANT_EXCLUSIVE_YEARLY=

# ── Visitor country (decides PKR/Safepay vs USD/Lemon Squeezy; users are never asked) ──
# 1) With TRUST_PROXY=true, country headers from your CDN/proxy are used first (CF-IPCountry, X-Vercel-IP-Country, CloudFront-Viewer-Country).
# 2) Otherwise the client IP is looked up through a geolocation API (default https://ipwho.is/{ip}, no key). Results are cached 24 h.
# GEOIP_URL=https://ipwho.is/{ip}  # any JSON API returning country_code / countryCode; {ip} and {key} are substituted
# GEOIP_API_KEY=
DEFAULT_BILLING_REGION=PK          # PK | INTL: used when the country cannot be determined (local/private IP, API down)
# GEOIP_FORCE_COUNTRY=             # TESTING ONLY (refused in production): pretend every visitor is in this country

# ── Backups ───────────────────────────────────────────────────────────────
# BACKUP_DIR=./backups          # needs pg_dump (postgresql-client)
# BACKUP_ENCRYPTION_KEY=        # set to encrypt backups at rest
# BACKUP_KEEP=14                # keep the newest N backups

# Legal entity shown on /terms, /privacy and /refund-policy
COMPANY_NAME=                      # e.g. "Your Company (Pvt) Ltd"
COMPANY_ADDRESS=
COMPANY_COUNTRY=Pakistan           # also the governing law in the Terms
SUPPORT_EMAIL=                     # shown as the contact address
LEGAL_EFFECTIVE_DATE=              # e.g. 2026-10-04 (defaults to 4 October 2026)
REFUND_WINDOW_DAYS=7               # 0 = no refunds

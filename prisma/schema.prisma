generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  WEBSITE
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
}

enum TeamRole {
  ADMIN
  ANALYST
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  XAI
  GOOGLE
}

model DashboardOwner {
  id           Int      @id @default(1)
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         TeamRole @default(ANALYST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([role, isActive])
}

model TeamInvite {
  id        String    @id @default(cuid())
  email     String
  role      TeamRole  @default(ANALYST)
  tokenHash String    @unique
  createdBy String
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email, acceptedAt])
  @@index([expiresAt])
}

model AiSettings {
  id        Int        @id @default(1)
  provider  AiProvider @default(OPENAI)
  model     String     @default("gpt-4o-mini")
  apiKey    String?
  updatedAt DateTime   @updatedAt
}

model Channel {
  id          String   @id @default(cuid())
  platform    Platform
  name        String
  handle      String?
  externalId  String?
  /// Page / profile URL for reference
  pageUrl     String?
  /// Per-page access token (LinkedIn / Meta). Prefer this over global .env when set.
  accessToken String?
  /// API key when needed (YouTube). Optional if accessToken is used.
  apiKey      String?
  /// Extra notes for the marketing team (who owns the page, etc.)
  notes       String?
  isActive    Boolean  @default(true)
  /// ACTIVE until an auth failure marks it NEEDS_RECONNECT.
  connectionStatus ConnectionStatus @default(ACTIVE)
  /// OAuth refresh token (encrypted). Null when a manual token is used.
  refreshToken     String?
  tokenExpiresAt   DateTime?
  lastSuccessAt    DateTime?
  /// Short, client-safe summary of the last failure.
  lastError        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots     MetricSnapshot[]
  dailyMetrics  ChannelDailyMetric[]
  websiteDaily  WebsiteDailyMetric[]
  breakdowns    WebsiteBreakdown[]
  posts         Post[]

  @@unique([platform, name])
  @@index([platform])
}

/// LEGACY (read-only history). Superseded by ChannelDailyMetric; never used for totals
/// because overlapping periods double counted.
model MetricSnapshot {
  id             String   @id @default(cuid())
  channelId      String
  syncedAt       DateTime @default(now())
  periodStart    DateTime
  periodEnd      DateTime
  followers      Int      @default(0)
  newFollowers   Int      @default(0)
  impressions    Int      @default(0)
  reach          Int      @default(0)
  engagement     Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  saves          Int      @default(0)
  profileVisits  Int      @default(0)
  videoViews     Int      @default(0)
  watchTimeMin   Float    @default(0)
  avgViewDurSec  Float    @default(0)
  returningViewers Int    @default(0)
  ctr            Float    @default(0)
  engagementRate Float    @default(0)
  postCount      Int      @default(0)
  // Platform-specific extras as JSON string when needed
  extras         String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, periodStart, periodEnd])
  @@index([syncedAt])
}

model Post {
  id           String   @id @default(cuid())
  channelId    String
  platform     Platform
  externalId   String
  title        String?
  content      String?
  thumbnailUrl String?
  permalink    String?
  publishedAt  DateTime
  postType     String?  // post, reel, story, video, short
  createdAt    DateTime @default(now())

  channel Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  metrics PostMetrics[]

  @@unique([channelId, externalId])
  @@index([platform, publishedAt])
  @@index([channelId])
}

/// One row per post per UTC day (lifetime counters as of that day). Re-fetching overwrites.
model PostMetrics {
  id             String   @id @default(cuid())
  postId         String
  date           DateTime
  fetchedAt      DateTime @default(now())
  likes          Int?
  comments       Int?
  shares         Int?
  impressions    Int?
  reach          Int?
  clicks         Int?
  saves          Int?
  views          Int?
  engagementRate Float?
  ctr            Float?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date])
  @@index([date])
}

/// One row per channel per UTC day. Null = the platform did not provide the metric.
model ChannelDailyMetric {
  id               String   @id @default(cuid())
  channelId        String
  date             DateTime
  /// End-of-day follower / subscriber count.
  followers        Int?
  /// Followers gained that day, when the API reports it directly.
  newFollowers     Int?
  impressions      Int?
  reach            Int?
  engagement       Int?
  likes            Int?
  comments         Int?
  shares           Int?
  clicks           Int?
  saves            Int?
  profileVisits    Int?
  videoViews       Int?
  watchTimeMin     Float?
  avgViewDurSec    Float?
  returningViewers Int?
  postCount        Int?
  /// API name + version that produced the row, e.g. "linkedin:202511".
  source           String
  fetchedAt        DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([date])
}

model WebsiteDailyMetric {
  id                    String   @id @default(cuid())
  propertyChannelId     String
  date                  DateTime
  users                 Int?
  sessions              Int?
  newUsers              Int?
  /// Percent 0-100.
  bounceRate            Float?
  avgSessionDurationSec Float?
  /// GA4 key events.
  conversions           Int?
  source                String
  fetchedAt             DateTime @default(now())

  channel Channel @relation(fields: [propertyChannelId], references: [id], onDelete: Cascade)

  @@unique([propertyChannelId, date])
  @@index([date])
}

/// GA4 traffic sources and landing pages, one row per day per key.
model WebsiteBreakdown {
  id          String   @id @default(cuid())
  channelId   String
  date        DateTime
  /// SOURCE or LANDING_PAGE
  kind        String
  key         String
  users       Int?
  sessions    Int?
  bounceRate  Float?
  fetchedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date, kind, key])
  @@index([date, kind])
}

/// LEGACY (read-only history). Superseded by WebsiteDailyMetric.
model WebsiteSnapshot {
  id                   String   @id @default(cuid())
  syncedAt             DateTime @default(now())
  periodStart          DateTime
  periodEnd            DateTime
  users                Int      @default(0)
  sessions             Int      @default(0)
  newUsers             Int      @default(0)
  bounceRate           Float    @default(0)
  avgSessionDurationSec Float   @default(0)
  conversions          Int      @default(0)
  goalCompletions      Int      @default(0)
  // JSON arrays: [{source, users, sessions}], [{page, sessions, bounceRate}]
  trafficSources       String?
  topLandingPages      String?

  @@index([periodStart, periodEnd])
}

model SyncRun {
  id         String     @id @default(cuid())
  platform   Platform
  status     SyncStatus @default(PENDING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  message    String?
  error      String?
  recordsUpserted Int   @default(0)
}
